# Copie para .env (não versionado) para rodar localmente, ou configure como
# Secrets do repositório no GitHub (Settings > Secrets and variables > Actions)
# para a varredura diária automática funcionar.

# Adzuna — conta gratuita em https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — chave gratuita em https://jooble.org/api/about
JOOBLE_API_KEY=
